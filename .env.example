# ─────────────────────────────────────────────────────────────
# Belle's Brush — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for SEO, sitemap and social sharing).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contact form email delivery (Resend) ─────────────────────
# Until ALL THREE are set, the contact form runs in clearly labelled
# demo mode and never claims a message was sent.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# CONTACT_TO_EMAIL=artist@example.com
# CONTACT_FROM_EMAIL="Belle's Brush <hello@yourdomain.com>"

# ── Phase 2: Supabase (not used yet) ─────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
